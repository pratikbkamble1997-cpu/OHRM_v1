{
  "default": {

    "paths":
     [
      "src/features/**/*.feature"
    ],

    "require": 
    [
      "src/stepDefinations/**/*.ts",
      "src/hooks/**/*.ts"
    ],

    "requireModule": 
    [
      "ts-node/register"
    ],

    "format": 
    [
      
      "json:reports/cucumber-report.json",
      "allure-cucumberjs/reporter",
      "progress"
      
    ],
  
    "formatOptions":
    {
      "resultsDir":"allure-results"


    },
     

    "publishQuiet": true
  }
}